# Copy this file to .env and fill in real values. .env itself is gitignored
# and must never be committed.

# --- Supabase (required) ---
# From your Supabase project's API settings.
SUPABASE_PROJECT_ID="your-project-id"
SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# --- AI provider (required — set ONE of these two blocks) ---
# If both are set, Qwen takes priority.

# Option A: Google Gemini
# GEMINI_API_KEY="your-gemini-api-key"
# GEMINI_MODEL="gemini-1.5-flash"

# Option B: Alibaba Cloud Qwen (DashScope)
# QWEN_API_KEY="your-dashscope-api-key"
# QWEN_MODEL="qwen-plus"
# QWEN_VISION_MODEL="qwen-vl-plus"
# QWEN_BASE_URL="https://dashscope-intl.aliyuncs.com/compatible-mode/v1"

# --- Error monitoring (optional) ---
# VITE_SENTRY_DSN="your-sentry-dsn"
# VITE_SENTRY_ENVIRONMENT="production"

# --- Scheduled jobs (optional) ---
# CRON_SECRET="a-random-string-you-choose"
# CRON_SECRET_PREVIOUS="previous-secret-during-rotation"
